
{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch ASP.NET Core API",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "dotnet",
      "args": [
        "run",
        "--no-build",
        "--launch-profile",
        "http"
      ],
      "cwd": "d:\\zenvy\\zenvy.Api\\zenvy.api",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "console": "integratedTerminal",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      }
    }
  ]
}
